            "    const json = pm.response.json();",
            "    pm.expect(json.blockchain).to.be.a('string');",
            "    pm.expect(['ethereum','fabric']).to.include(json.blockchain);",
            "});",
            "pm.test('[S12] Status sistem = OK', function () {",
            "    const json = pm.response.json();",
            "    pm.expect(json.status).to.equal('OK');",
            "    pm.expect(json.success).to.be.true;",
            "});",
            "console.log('[S12] Platform aktif saat ini:', pm.response.json().blockchain);"
          ]}}],
          "request": {
            "method": "GET", "url": "{{BASE_URL}}/health"
          }
        }
      ]
    },

    {
