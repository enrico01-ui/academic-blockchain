    {
      "name": "--- FR-02: INPUT DATA AKADEMIK ---",
      "item": [
        {
          "name": "Skenario 3 - Input data akademik → hash tercatat di blockchain",
          "event": [{
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate student_id unik sebelum request dikirim",
              "const ts = Math.floor(Date.now() / 1000);",
              "const sid = 'FUNC_TEST_' + ts;",
              "pm.collectionVariables.set('student_id_test', sid);",
              "console.log('✓ Student ID dibuat:', sid);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",

              "pm.test('[S3] HTTP 201 - Data berhasil dicatat dan blockchain confirmed', function () {",
              "    pm.response.to.have.status(201);",
              "});",

              "pm.test('[S3] Response mengandung data_hash SHA-256 (64 hex chars)', function () {",
              "    pm.expect(json.data.data_hash).to.be.a('string').and.have.lengthOf(64);",
              "});",

              "pm.test('[S3] Response mengandung tx_id dari blockchain', function () {",
              "    pm.expect(json.data.tx_id).to.not.be.null;",
              "    pm.expect(json.data.tx_id).to.be.a('string').and.have.length.above(5);",
              "});",

              "pm.test('[S3] Status record = confirmed', function () {",
              "    pm.expect(json.data.status).to.equal('confirmed');",
              "});",

              "if (json.data && json.data.id) {",
              "    pm.collectionVariables.set('record_id', json.data.id);",
              "    console.log('✓ Record ID tersimpan:', json.data.id);",
              "}"
            ]
          }
        }],
          "request": {
            "method": "POST", "url": "{{BASE_URL}}/academic/record",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"{{student_id_test}}\",\n  \"student_name\": \"Mahasiswa Uji Fungsional\",\n  \"course_code\": \"IF-3001\",\n  \"course_name\": \"Pengujian Fungsional\",\n  \"grade\": \"A\",\n  \"gpa_point\": 4.00,\n  \"semester\": 1,\n  \"academic_year\": \"2024/2025\",\n  \"attendance\": \"always\"\n}" }
          }
        }
      ]
    },

    {
      "name": "--- FR-03: VERIFIKASI INTEGRITAS DATA ---",
      "item": [
        {
          "name": "Skenario 4 - Verifikasi data valid → isValid: true",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[S4] HTTP 200 - Verifikasi berhasil', function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "pm.test('[S4] isValid = true untuk data yang tidak dimanipulasi', function () {",
            "    const json = pm.response.json();",
            "    pm.expect(json.verification.isValid).to.be.true;",
            "});",
            "pm.test('[S4] expectedHash dan actualHash tersedia di response', function () {",
            "    const json = pm.response.json();",
            "    pm.expect(json.verification.expectedHash).to.be.a('string').and.have.lengthOf(64);",
            "    pm.expect(json.verification.actualHash).to.be.a('string').and.have.lengthOf(64);",
            "});",
            "pm.test('[S4] Kedua hash identik', function () {",
            "    const v = pm.response.json().verification;",
            "    pm.expect(v.expectedHash).to.equal(v.actualHash);",
            "});",
            "console.log('VERIFY student_id:', pm.collectionVariables.get('student_id_test'));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{BASE_URL}}/verify/hash",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"{{student_id_test}}\"\n}" }
          }
        },
        {
          "name": "Skenario 5 - Verifikasi data dimanipulasi → isValid: false [MANUAL]",
          "event": [{ "listen": "test", "script": { "exec": [
            "// ============================================================",
            "// SKENARIO 5 — PETUNJUK PELAKSANAAN MANUAL",
            "// ============================================================",
            "// Langkah sebelum menjalankan request ini:",
            "//",
            "// 1. Buka terminal / pgAdmin, jalankan SQL berikut:",
            "//    UPDATE academic_records",
            "//    SET grade = 'E', gpa_point = 0.00",
            "//    WHERE student_id = 'FUNC_TEST_001';",
            "//",
            "// 2. Jalankan request ini (POST /verify/hash)",
            "//    → isValid HARUS false karena hash di DB berubah",
            "//      tapi hash di blockchain tetap (hash grade A)",
            "//",
            "// 3. Setelah selesai, kembalikan data asli:",
            "//    UPDATE academic_records",
            "//    SET grade = 'A', gpa_point = 4.00",
            "//    WHERE student_id = 'FUNC_TEST_001';",
            "// ============================================================",
            "",
            "pm.test('[S5] HTTP 200 - Endpoint verifikasi merespons', function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "pm.test('[S5] isValid = false (data telah dimanipulasi)', function () {",
            "    const json = pm.response.json();",
            "    pm.expect(json.verification.isValid).to.be.false;",
            "    console.log('Hash DB    :', json.verification.expectedHash?.slice(0,16));",
            "    console.log('Hash BC    :', json.verification.actualHash?.slice(0,16));",
            "    console.log('Pesan      :', json.verification.message);",
            "});"
          ]}}],
          "request": {
            "method": "POST", "url": "{{BASE_URL}}/verify/hash",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"{{student_id_test}}\"\n}" }
          }
        }
      ]
    },

